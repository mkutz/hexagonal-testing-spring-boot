root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# ktfmt googleStyle: 2-space indent, 100-column limit
[*.{kt,kts}]
max_line_length = 100

[*.toml]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
